{
  "name": "mcp-nodejs-llama",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) implementation with Node.js, TypeScript, and Llama-3.x integration",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "server": "tsx src/server/index.ts",
    "client": "tsx src/client/index.ts",
    "server:dev": "tsx watch src/server/index.ts",
    "client:dev": "tsx watch src/client/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rimraf dist",
    "prestart": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llama",
    "llm",
    "ai",
    "typescript",
    "nodejs",
    "ollama"
  ],
  "author": "DevOps Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.2.0",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "winston": "^3.11.0",
    "yargs": "^17.7.2",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jylhakos/InternetOfThings.git"
  },
  "bugs": {
    "url": "https://github.com/jylhakos/InternetOfThings/issues"
  },
  "homepage": "https://github.com/jylhakos/InternetOfThings#readme"
}
