{
  "name": "express-debugging-demo",
  "version": "1.0.0",
  "description": "Complete debugging setup for Express.js and Node.js applications",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "debug": "node --inspect app.js",
    "debug-brk": "node --inspect-brk app.js",
    "test": "mocha test/**/*.test.js",
    "test:watch": "mocha test/**/*.test.js --watch",
    "test:coverage": "nyc mocha test/**/*.test.js",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "express",
    "nodejs",
    "debugging",
    "vscode",
    "testing"
  ],
  "author": "Developer",
  "license": "MIT",
  "dependencies": {
    "debug": "^4.3.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.9",
    "chai": "^4.3.8",
    "eslint": "^8.48.0",
    "jest": "^29.6.4",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.1",
    "nyc": "^15.1.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/express-debugging-demo.git"
  }
}
