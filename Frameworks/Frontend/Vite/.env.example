# Environment Variables Example
# Copy this file to .env.local and modify as needed

# Application Configuration
VITE_APP_TITLE=Vite Development Setup
VITE_APP_VERSION=1.0.0

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=5000

# Feature Flags
VITE_ENABLE_DEBUG_MODE=true
VITE_ENABLE_ANALYTICS=false

# Build Configuration
VITE_BUILD_TARGET=es2020
VITE_OUTPUT_DIR=dist

# Development Configuration
VITE_DEV_PORT=5173
VITE_DEV_HOST=localhost
VITE_ENABLE_HMR=true

# Note: Only variables prefixed with VITE_ will be available in the client
# Other variables are only available in the build process
