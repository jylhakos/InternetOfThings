{
  "name": "nextjs-iot-app",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js IoT application with SSR and TypeScript",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "export": "next build && next export",
    "analyze": "cross-env ANALYZE=true npm run build",
    "docker:build": "docker build -t nextjs-iot-app .",
    "docker:run": "docker run -p 3000:3000 nextjs-iot-app",
    "docker:dev": "docker-compose up --build"
  },
  "dependencies": {
    "next": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.3",
    "@next/bundle-analyzer": "^15.0.3",
    "cross-env": "^7.0.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "ssr",
    "iot",
    "server-side-rendering"
  ],
  "author": "IoT Development Team",
  "license": "MIT"
}
