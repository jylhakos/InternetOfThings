# ======================================
# Comprehensive .gitignore for Vite IoT Project
# ======================================

.github/

# Dependencies and Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/
.yarnrc.yml

# Build outputs and distributions
dist/
build/
*.tsbuildinfo

# Cache directories
.vite/
.cache/
.temp/
.tmp/

# Environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# IDE and editor files
.vscode/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
.idea/*
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.atom/
.brackets.json
.editorconfig
.history/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs
logs/
*.log

# Coverage reports
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# ESLint cache
.eslintcache

# Prettier cache
.prettiercache

# Stylelint cache
.stylelintcache

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Local Netlify folder
.netlify

# Vite temporary files
vite.config.js.timestamp*
vite.config.ts.timestamp*

# Local development files
*.local

# Package lock files (choose one based on your package manager)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Auto-generated files
auto-imports.d.ts
components.d.ts

# Binaries and executables
*.exe
*.bin
*.dmg
*.pkg
*.deb
*.rpm
*.msi
*.app
*.run
*.AppImage
*.snap
*.flatpak

# Compiled libraries and object files
*.so
*.so.*
*.dylib
*.dll
*.lib
*.a
*.o
*.obj
*.lo
*.la
*.al
*.libs
*.ko
*.elf

# Archive files
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip
*.rar
*.7z
*.gz
*.bz2
*.xz
*.Z

# Python bytecode
*.pyc
*.pyo
*.pyd
__pycache__/
*.py[cod]
*$py.class

# Java class files
*.class
*.jar
*.war
*.ear

# C/C++ compiled files
*.out
*.exe
*.o
*.so
*.dll

# Rust compiled files
target/
Cargo.lock

# Go compiled files
*.exe
*.exe~
*.dll
*.so
*.dylib

# WebAssembly files (unless explicitly needed)
*.wasm

# Backup files
*.bak
*.backup
*.orig

# Test output
test-results/
playwright-report/
test-results.xml
junit.xml
coverage.xml

# Docker files (optional - uncomment if you don't want to track these)
# Dockerfile
# docker-compose.yml
# .dockerignore

# Database files
*.sqlite
*.sqlite3
*.db
*.database

# Certificate and key files
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Configuration files with sensitive data
config.local.*
*.secret
*.private

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov/

# Grunt intermediate storage
.grunt/

# Bower dependency directory
bower_components/

# JSPM packages
jspm_packages/

# Typescript v1 declaration files
typings/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache
.parcel-cache

# VSCode extension folders
.vscode-test/

# SvelteKit build / generate output
.svelte-kit/

# Temporary files
*.tmp
*.temp
*~

# ======================================
# IoT and Hardware Specific Files
# ======================================

# Microcontroller firmware
*.hex
*.ino.bin
*.ino.elf
*.ino.map

# Arduino/ESP32/ESP8266
libraries/
hardware/
*.fqbn
*.partitions.csv

# Raspberry Pi
*.img
*.iso
boot/
rootfs/

# Circuit design files (large binaries)
*.pcb~
*.sch~
*.brd~
*.kicad_pcb-bak
*.net
*.dsn
*.ses

# 3D models and CAD files (if binary)
*.stl
*.step
*.stp
*.iges
*.igs

# ======================================
# Development Tools and IDEs
# ======================================

# JetBrains IDEs
.idea/
*.iws
*.iml
*.ipr

# Visual Studio
.vs/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# Eclipse
.project
.metadata
.classpath
.settings/

# Xcode
*.xcodeproj
*.xcworkspace

# ======================================
# Cloud and Deployment
# ======================================

# Vercel
.vercel/

# Netlify
.netlify/

# AWS
.aws/
aws-exports.js

# Google Cloud Platform
.gcp/
gcp-key.json

# Heroku
.heroku/

# ======================================
# Security and Sensitive Data
# ======================================

# API Keys and Secrets
.secrets/
secrets.json
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx

# MQTT credentials
mqtt-config.json
broker-config.json

# ======================================
# Documentation and Reports
# ======================================

# Generated documentation
docs/build/
site/
*.pdf
*.docx

# Reports
reports/
benchmarks/
