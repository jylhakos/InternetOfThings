{
  "name": "vite-development-setup",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vite development setup for JavaScript and TypeScript with debugging support",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:debug": "vite --debug",
    "dev:profile": "vite --profile",
    "dev:host": "vite --host 0.0.0.0",
    "build:analyze": "vite build && npx vite-bundle-analyzer dist",
    "build:sourcemap": "vite build --sourcemap",
    "clean": "rm -rf dist node_modules/.vite",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "test": "echo \"Add your test command here\"",
    "test:coverage": "echo \"Add your coverage command here\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitejs/plugin-vue": "^5.1.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^6.0.0",
    "vite-bundle-analyzer": "^0.11.0"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "lodash": "^4.17.21"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "vite",
    "typescript",
    "javascript",
    "development",
    "debugging",
    "devops",
    "build-tools"
  ],
  "author": "Development Team",
  "license": "MIT"
}
