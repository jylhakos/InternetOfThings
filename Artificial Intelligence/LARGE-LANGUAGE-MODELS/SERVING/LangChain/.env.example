# Environment Variables
NODE_ENV=development
PORT=3000

# LLM Configuration
LLM_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
LLM_MODEL_PATH=/models/llama-3.1-8b-instruct
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9

# OpenAI Compatible API (for fallback or testing)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Hugging Face Configuration
HUGGINGFACE_API_KEY=your_huggingface_token_here
HUGGINGFACE_MODEL_ENDPOINT=https://api-inference.huggingface.co/models/meta-llama/Llama-3.1-8B-Instruct

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Database (for user management)
DATABASE_URL=sqlite:./data/users.db

# AWS Configuration (for deployment)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your_aws_account_id
ECS_CLUSTER_NAME=llm-inference-cluster
ECS_SERVICE_NAME=llm-inference-service

# Docker Configuration
DOCKER_IMAGE_NAME=llm-inference-server
DOCKER_TAG=latest

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_KEY_PATH=/etc/ssl/private/server.key

# Model Quantization Settings
USE_QUANTIZED_MODEL=true
QUANTIZATION_BITS=4
GPU_MEMORY_FRACTION=0.8
MAX_SEQUENCE_LENGTH=4096
