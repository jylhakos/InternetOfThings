# Quick Start Configuration Example
# Copy this to .env and configure for your setup

# Basic Configuration
NODE_ENV=development
PORT=3000

# Model Configuration (Choose one)
# Option 1: Use OpenAI API for testing
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Option 2: Use HuggingFace Inference API (Recommended for Llama)
# HUGGINGFACE_API_KEY=hf_your-huggingface-token-here
# HUGGINGFACE_MODEL_ENDPOINT=https://api-inference.huggingface.co/models/meta-llama/Llama-3.1-8B-Instruct

# Option 3: Use Local Ollama Server
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

# LLM Settings
LLM_MODEL_NAME=gpt-3.5-turbo
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
