# LLM Provider API Keys
# OpenAI API key for ChatGPT and embeddings
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API key for Claude models (optional)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Hugging Face API key for model inference (optional)
# HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# Cohere API key (optional)
# COHERE_API_KEY=your-cohere-api-key-here


# Langfuse Configuration
# Get your keys from https://cloud.langfuse.com or use local deployment
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here

# For local Langfuse deployment (default: http://localhost:3000)
LANGFUSE_HOST=http://localhost:3000

# For cloud Langfuse deployment
# LANGFUSE_HOST=https://cloud.langfuse.com


# Helicone Configuration (optional)
# Get your key from https://www.helicone.ai
# HELICONE_API_KEY=your-helicone-api-key-here


# Arize Configuration (optional)
# For Arize Cloud platform
# ARIZE_API_KEY=your-arize-api-key-here
# ARIZE_SPACE_ID=your-space-id-here


# Azure Configuration (optional)
# For Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-openai-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2023-12-01-preview

# For Azure Application Insights
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://region.in.applicationinsights.azure.com/


# Google Cloud Configuration (optional)
# Path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-project-id


# Other Configuration
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable detailed tracing
ENABLE_TRACING=true

# Session identifier for grouping traces
SESSION_ID=default-session
