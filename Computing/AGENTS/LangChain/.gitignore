# LangSmith / Observability
# ==============================
langsmith_traces/

# Stray files from malformed pip install commands (shell redirection artefacts)
# e.g. pip install langchain>=1.0 without quotes creates a file named =1.0
=*

# ==============================
# LangChain Package Binaries
# ==============================
# pip-installed LangChain package directories that may appear if installed
# outside a venv or copied into the project folder directly
langchain/
langchain_core/
langchain_community/
langchain_ollama/
langchain_openai/
langchain_anthropic/
langchain_google_genai/
langchain_text_splitters/
langgraph/
langsmith/

# Compiled C extensions produced by LangChain / pydantic / tokenizers
*.so
*.pyd
*.dll

# Wheel and sdist archives
*.whl
*.tar.gz

# pip download cache
pip_cache/
.pip/

# Package metadata directories written next to source by some installers
*.dist-info/
*.egg-info/
