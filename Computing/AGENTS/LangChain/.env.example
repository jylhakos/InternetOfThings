# ============================================================
# LLM Provider Selection
# ============================================================
# Set to "ollama" for free local inference (default)
# Set to "openai" to use OpenAI cloud API
LLM_PROVIDER="ollama"

# ============================================================
# Ollama Configuration (local inference - no API key needed)
# ============================================================
# URL of the Ollama server (default: localhost)
OLLAMA_BASE_URL="http://localhost:11434"

# Model to use with Ollama - see README for available models
# Recommended lightweight models:
#   llama3.2       (default, 2.0 GB, good tool use)
#   llama3.2:1b    (1.3 GB, fastest, basic tasks)
#   phi3:mini      (2.2 GB, Microsoft, efficient)
#   gemma2:2b      (1.6 GB, Google, efficient)
#   qwen2.5:3b     (2.0 GB, Alibaba, very capable)
#   mistral        (4.1 GB, excellent quality)
OLLAMA_MODEL="llama3.2"

# ============================================================
# OpenAI Configuration (cloud API - requires paid API key)
# ============================================================
# Uncomment and set if LLM_PROVIDER="openai"
# OPENAI_API_KEY="sk-your-api-key-here"
# OPENAI_MODEL="gpt-3.5-turbo"

# ============================================================
# Optional: Other LLM providers
# ============================================================
# ANTHROPIC_API_KEY="your-anthropic-key-here"
# GOOGLE_API_KEY="your-google-key-here"
