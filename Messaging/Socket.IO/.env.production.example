# Production Environment Configuration Template
# Copy this file to .env and update with your actual values

# Database Configuration
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=secure_database_password_here
POSTGRES_DB=weatherdb
DATABASE_URL=postgresql+asyncpg://weather_user:secure_database_password_here@db:5432/weatherdb

# JWT Configuration - CHANGE THIS IN PRODUCTION!
JWT_SECRET_KEY=your-super-secure-production-jwt-secret-key-256-bits-long

# Weather API Configuration
# Get your free API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# CORS Origins (adjust for your domain)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Optional: Sentry for error monitoring
# SENTRY_DSN=your-sentry-dsn-here

# Optional: Redis for session storage
# REDIS_URL=redis://redis:6379/0